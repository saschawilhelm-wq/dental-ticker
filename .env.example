# Kopieren nach .env.local und anpassen. .env.local wird nie eingecheckt.

# Postgres-Verbindung (lokal oder Supabase, Region Frankfurt).
# Bei Supabase die „Session pooler“-Adresse mit ?sslmode=require verwenden.
DATABASE_URL=postgres://dental:dental@localhost:5432/dental_ticker

# Öffentliche Adresse der App. Wird für Login-Links verwendet und muss im
# Produktivbetrieb gesetzt sein (nie aus dem Host-Header ableiten).
APP_URL=http://localhost:3000

# Separate Datenbank für die Integrationstests (wird von den Tests geleert!).
TEST_DATABASE_URL=postgres://dental:dental@localhost:5432/dental_ticker_test
